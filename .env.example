# Database
DATABASE_URL=postgresql://eroverwatch:eroverwatch@localhost:5432/eroverwatch
REDIS_URL=redis://localhost:6379/0

# LiveKit Cloud — from https://cloud.livekit.io project settings
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# rPPG runs server-side (backend/rppg) — no extra API keys required for fall detection
# (falls are detected in the browser on nurse-command)

# Gemini — required for AI intake assistant (casefile chat) and nurse triage notes
GEMINI_API_KEY=

# Firebase Auth (set true when Google + Anonymous providers are configured)
REQUIRE_FIREBASE_AUTH=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Frontend mock toggles — set false for live rPPG / WebSocket testing
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REQUIRE_FIREBASE_AUTH=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

VITE_USE_MOCK=false
VITE_API_URL=http://localhost:8000
VITE_PATIENT_CLIENT_URL=https://patient.eroverwatch.tech
VITE_REQUIRE_FIREBASE_AUTH=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
