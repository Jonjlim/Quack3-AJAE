# Database
DATABASE_URL=postgresql://eroverwatch:eroverwatch@localhost:5432/eroverwatch
REDIS_URL=redis://localhost:6379/0

# LiveKit Cloud — from https://cloud.livekit.io project settings
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scene Intelligence (Architect 4 only)
OPENAI_API_KEY=

# Frontend mock toggles (set true until backend is integrated)
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000
