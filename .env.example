# Database
DATABASE_URL=postgresql://eroverwatch:eroverwatch@localhost:5432/eroverwatch
REDIS_URL=redis://localhost:6379/0

# LiveKit (matches docker-compose dev keys)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scene Intelligence (Architect 4 only)
OPENAI_API_KEY=

# Frontend mock toggles (set true until backend is integrated)
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000
